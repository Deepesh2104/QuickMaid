Enum kyc_doc_type {
  aadhaar
  pan
  police_verification
  bank_proof
  training_certificate
  profile_photo
  selfie
}

Enum marital_status {
  single
  married
  widowed
  other
}

Enum travel_mode {
  walk
  cycle
  bus
  auto
  bike
}

Enum kyc_doc_status {
  missing
  pending
  verified
  rejected
}

Enum application_status {
  submitted
  under_review
  approved
  rejected
}

Enum subscription_plan_type {
  instant
  monthly
  annual
  plus
  flex
  onetime
}

Enum subscription_status {
  active
  paused
  cancelled
  expired
}

Enum coupon_discount_type {
  percent
  flat
}

Enum coupon_category {
  booking
  plus
  all
}

Enum coupon_status {
  draft
  live
  ended
}

Enum customer_coupon_status {
  active
  used
  expired
}

Enum referral_status {
  pending
  credited
  expired
}

Enum ticket_topic {
  booking
  payment
  plus
  partner
  dispute
  other
}

Enum ticket_status {
  open
  in_review
  resolved
  snoozed
}

Enum dispute_reason {
  quality
  incomplete
  damage
  behavior
  billing
  other
}

Enum dispute_status {
  submitted
  in_review
  resolved
  rejected
}

Enum message_sender {
  customer
  maid
  agent
  system
}

Enum notification_channel {
  push
  sms
  whatsapp
  email
  in_app
}

Enum notification_category {
  booking
  pro
  payment
  offer
  system
}

Enum payout_batch_status {
  draft
  processing
  paid
  failed
  held
}

Enum payout_line_status {
  pending
  ready
  held
  paid
  failed
}

Enum admin_role_key {
  super_admin
  ops_manager
  support_l1
  support_l2
  analyst
  finance
}

Enum cancel_reason {
  schedule
  alternative
  maid
  price
  no_show
  admin
  other
}

