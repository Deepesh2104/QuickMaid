// =============================================================================
// QuickMaid — Production Database Schema (PostgreSQL)
// =============================================================================
// HOW TO OPEN (read this — wrong import causes SQL parse errors):
//   1. Go to https://dbdiagram.io/d
//   2. Click "New Diagram" → choose language: DBML (NOT MySQL / NOT PostgreSQL SQL)
//   3. Paste ALL of this file into the LEFT code editor panel
//   4. Diagram renders on the right automatically
//
// DO NOT use "Import from MySQL" modal — that expects mysqldump SQL, not DBML.
// The error "mismatched input '/'" means you pasted DBML into the SQL importer.
// =============================================================================
// Clients : Customer App (RN) | Maid/Partner App (RN) | Admin (Angular)
// Version : 1.2 FINAL — see SCHEMA_FINAL.md for full specification
// =============================================================================

Project QuickMaid {
  database_type: 'PostgreSQL'
  Note: '''
    **Design principles**
    • Single source of truth — one DB for web admin, customer & maid apps
    • Auth substrate (`users`) + role-specific profile tables (customers, maids, admin_users)
    • Financial immutability — payments, refunds, wallet ledger are append-only
    • Booking snapshots — address/payment/price frozen at order time (JSONB + FKs)
    • Soft-delete PII — `deleted_at` on profiles; hard-delete via DSAR workflow
    • RBAC enforced server-side — never trust Angular role labels alone
    • Real-time dispatch — hot state in Redis; DB stores assignments & history
    • Multi-city ready — `cities` → `zones`; Raipur seeded first
    • Transactional outbox — `domain_events` for reliable FCM/SMS/webhooks
    • High-volume partition — `maid_location_pings`, `audit_logs`, `notifications` (monthly)
    • Denormalized counters — `total_visits`, `avg_rating` synced via jobs; ledger is truth for money
  '''
}

// =============================================================================
// ENUMS
// =============================================================================

Enum user_role {
  customer
  maid
  admin
}

Enum assignment_response {
  pending
  accepted
  declined
  expired
}

Enum user_status {
  active
  suspended
  pending_verification
  deleted
}

Enum gender {
  female
  male
  other
  prefer_not_to_say
}

Enum home_type {
  bhk_1
  bhk_2
  bhk_3
  villa
  other
}

Enum address_label {
  home
  office
  other
}

Enum payment_method_type {
  upi
  card
  netbanking
  wallet
  cash
  pay_later
  emi
}

Enum booking_status {
  draft
  pending_payment
  confirmed
  assigned
  en_route
  in_progress
  completed
  cancelled
  no_show
}

Enum payment_status {
